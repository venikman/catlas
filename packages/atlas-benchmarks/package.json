{
  "name": "@catlas/atlas-benchmarks",
  "version": "0.1.0",
  "type": "module",
  "description": "Atlas-specific API, render, LOD, and clickable audit benchmark suite.",
  "bin": {
    "atlas-benchmark": "dist/run-benchmarks.js",
    "atlas-clickable-audit": "dist/run-clickable-audit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/run-benchmarks.d.ts",
      "import": "./dist/run-benchmarks.js"
    }
  },
  "files": [
    "dist",
    "src/sql",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/fix-dist-esm-imports.ts dist && chmod +x dist/run-benchmarks.js dist/run-clickable-audit.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "run": "tsx src/run-benchmarks.ts",
    "clickable": "tsx src/run-clickable-audit.ts"
  },
  "dependencies": {
    "@catlas/atlas-react": "*",
    "pg": "^8.16.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
