# Local benchmark DB from docker-compose.postgres.yml.
DATABASE_URL=postgres://atlas:atlas@localhost:54322/atlas_bench
ATLAS_DEMO_MODE=false
ATLAS_DEBUG=false
NEXT_PUBLIC_ATLAS_DEBUG=false
ATLAS_ENABLE_SERVER_TIMING=true

ATLAS_MAX_POINTS_PER_RESPONSE=5000
ATLAS_MAX_CLUSTERS_PER_RESPONSE=600
ATLAS_MAX_REPRESENTATIVE_POINTS_PER_RESPONSE=760
ATLAS_MAX_DENSITY_TILES_PER_RESPONSE=240
ATLAS_MAX_SEARCH_RESULTS=20
ATLAS_MAX_BBOX_SPAN=80
ATLAS_MAX_HIGH_ZOOM_BBOX_SPAN=12

ATLAS_CACHE_TTL_VIEWS=300
ATLAS_CACHE_TTL_LOW_ZOOM=300
ATLAS_CACHE_TTL_MEDIUM_ZOOM=90
ATLAS_CACHE_TTL_HIGH_ZOOM=20
ATLAS_CACHE_TTL_ENTITY=300
ATLAS_CACHE_TTL_SEARCH=45

ATLAS_BASE_URL=http://localhost:3002
