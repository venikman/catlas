{
  "name": "semantic-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "generate:atlas": "tsx scripts/generate-atlas.ts",
    "seed:atlas": "tsx scripts/seed-atlas.ts",
    "atlas:seed": "tsx scripts/seed-atlas.ts",
    "atlas:stats": "tsx scripts/atlas-stats.ts",
    "atlas:db:stats": "tsx scripts/atlas-db-stats.ts",
    "atlas:smoke": "tsx scripts/atlas-smoke.ts",
    "atlas:loadtest": "tsx scripts/atlas-loadtest.ts",
    "atlas:analyze-queries": "tsx scripts/atlas-analyze-queries.ts",
    "bench:atlas": "tsx benchmarks/run-benchmarks.ts --profile standard",
    "bench:atlas:quick": "tsx benchmarks/run-benchmarks.ts --profile quick",
    "bench:atlas:full": "tsx benchmarks/run-benchmarks.ts --profile full",
    "bench:atlas:api": "tsx benchmarks/run-benchmarks.ts --profile quick --validators api,payload,search",
    "bench:atlas:render": "tsx benchmarks/run-benchmarks.ts --profile quick --validators render,interaction,memory",
    "bench:atlas:lod": "tsx benchmarks/run-benchmarks.ts --profile quick --validators lod",
    "bench:atlas:db": "tsx benchmarks/run-benchmarks.ts --profile standard --validators dbQuery",
    "bench:atlas:report": "tsx benchmarks/report-latest.ts",
    "validate:atlas": "npm run typecheck && npm test && npm run build && npm run bench:atlas:quick -- --gate --start-server --server=start"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.7",
    "pg": "^8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
